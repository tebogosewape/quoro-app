# Experian API Configuration
# ===========================
# These credentials are required for the real Experian credit bureau integration
# Contact Experian South Africa to obtain your API credentials

# Experian SOAP API endpoint
# Production: https://secure.experian.co.za/cais/webservice/NormalSearchV2
# Sandbox/UAT: https://sandbox.experian.co.za/cais/webservice/NormalSearchV2
EXPERIAN_API_URL=https://sandbox.experian.co.za/cais/webservice/NormalSearchV2

# Your Experian subscriber code (provided by Experian)
EXPERIAN_SUBSCRIBER_CODE=YOUR_SUBSCRIBER_CODE_HERE

# Your Experian API username
EXPERIAN_USERNAME=YOUR_USERNAME_HERE

# Your Experian API password
EXPERIAN_PASSWORD=YOUR_PASSWORD_HERE

# Request timeout in milliseconds (default: 30000)
EXPERIAN_TIMEOUT=30000

# Enable/disable mock mode (set to 'false' for production)
# When true, will generate mock data instead of calling real API
EXPERIAN_MOCK_MODE=true

# Data retention policy (days)
# How long to keep credit report data (POPIA compliance)
EXPERIAN_DATA_RETENTION_DAYS=365

# Notes:
# ------
# 1. Never commit these credentials to version control
# 2. Use different credentials for development/staging/production
# 3. Rotate passwords regularly
# 4. Monitor API usage to avoid unexpected charges
# 5. Ensure POPIA compliance for all credit checks
