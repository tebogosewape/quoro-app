# Experian Normal Search V2.17 - UAT example
# Never commit real credentials. Every submitted enquiry may be billable.
EXPERIAN_ENV=uat
EXPERIAN_WSDL=https://apis-uat.experian.co.za/NormalSearchService?wsdl
EXPERIAN_API_URL=https://apis-uat.experian.co.za/NormalSearchService
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=
# Optional internal reference only. Normal Search V2.17 does not send this as a SOAP parameter.
EXPERIAN_SUBSCRIBER_CODE=
EXPERIAN_ORIGIN=
EXPERIAN_ORIGIN_VERSION=1
EXPERIAN_WSSECURITY=false
EXPERIAN_ENQUIRER_NAME=QFinance
EXPERIAN_ENQUIRER_TEL=
EXPERIAN_DATA_RETENTION_DAYS=365
