NODE_ENV=qa
PORT=2200
CORS_ORIGIN=https://qa-app.example.com
WEB_APP_URL=https://qa-app.example.com

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=quora_app
DB_PASSWORD=change-me
DB_NAME=quora_app
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=quora_app
MYSQL_USER=quora_app
MYSQL_PASSWORD=change-me

JWT_SECRET=replace-with-qa-jwt-secret
JWT_REFRESH_SECRET=replace-with-qa-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace-with-qa-session-secret
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
TRACE_HEADER_NAME=X-Trace-Id
PASSWORD_RESET_TTL_MINUTES=30

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.qa.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=no-reply.qa@example.com
SMTP_PASSWORD=replace-with-qa-smtp-password
SMTP_FROM=no-reply.qa@example.com
IMAP_HOST=imap.qa.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=no-reply.qa@example.com
IMAP_PASSWORD=replace-with-qa-imap-password
IMAP_MAILBOX=INBOX

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=quora-app-qa
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_ATTEMPTS=5
EMAIL_QUEUE_BACKOFF_MS=5000
EMAIL_QUEUE_BACKOFF_STRATEGY=exponential
EMAIL_QUEUE_REMOVE_ON_COMPLETE=true
EMAIL_QUEUE_REMOVE_ON_FAIL=false

SMS_PROVIDER=mock
SMS_BASE_URL=
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=

EXPERIAN_ENV=qa
EXPERIAN_BASE_URL=https://experian.qa.example.com
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=

LOG_LEVEL=info

QUEUE_DASHBOARD_ENABLED=false
QUEUE_DASHBOARD_PATH=/queues
QUEUE_DASHBOARD_USERNAME=monitor
QUEUE_DASHBOARD_PASSWORD=change-me
