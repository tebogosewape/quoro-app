{
    "name": "api",
    "version": "1.0.0",
    "description": "Quora Financial API - NestJS Backend",
    "main": "dist/main.js",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "start:worker": "nest start --entryFile worker",
        "start:worker:dev": "nest start --watch --entryFile worker",
        "start:worker:prod": "node dist/worker",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typecheck": "tsc --noEmit",
        "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
        "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
        "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
        "seed:run": "ts-node src/database/seeds/run-seeds.ts",
        "db:reset": "npm run migration:revert && npm run migration:run && npm run seed:run",
        "email:demo": "ts-node --transpile-only src/demo-email-roundtrip.ts",
        "db:seed:rbac": "ts-node -r tsconfig-paths/register -T src/database/seeds/seed-rbac.ts"
    },
    "dependencies": {
        "@bull-board/api": "^5.23.0",
        "@bull-board/express": "^5.23.0",
        "@nestjs/common": "^10.2.8",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^10.2.8",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^9.0.0",
        "@nestjs/passport": "^9.0.0",
        "@nestjs/platform-express": "^10.2.8",
        "@nestjs/swagger": "^7.1.14",
        "@nestjs/throttler": "^4.2.1",
        "@nestjs/typeorm": "^9.0.0",
        "@types/handlebars": "^4.0.40",
        "@types/passport": "^1.0.17",
        "@vitest/ui": "3.2.4",
        "adm-zip": "^0.5.16",
        "axios": "^1.6.7",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "bull": "^4.16.5",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "fast-csv": "^5.0.5",
        "fast-xml-parser": "^5.2.5",
        "handlebars": "^4.7.8",
        "helmet": "^7.1.0",
        "imapflow": "^1.0.136",
        "joi": "^17.12.0",
        "mailparser": "^3.7.5",
        "mysql2": "^3.9.1",
        "nodemailer": "^7.0.9",
        "passport": "^0.6.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pdfmake": "^0.2.20",
        "redis": "^5.8.3",
        "reflect-metadata": "^0.1.14",
        "rxjs": "^7.8.1",
        "soap": "^1.6.0",
        "typeorm": "^0.3.20",
        "uuid": "^9.0.1",
        "vitest": "3.2.4",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.2.8",
        "@nestjs/schematics": "^10.1.1",
        "@nestjs/testing": "^10.2.8",
        "@types/adm-zip": "^0.5.7",
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/bull": "^3.15.9",
        "@types/express": "^4.17.23",
        "@types/jest": "^29.5.12",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.19.22",
        "@types/nodemailer": "^6.4.14",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/pdfmake": "^0.2.12",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^7.1.1",
        "@typescript-eslint/parser": "^7.1.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.2",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "coverageThreshold": {
            "global": {
                "lines": 80,
                "branches": 70,
                "functions": 80,
                "statements": 80
            }
        }
    }
}
