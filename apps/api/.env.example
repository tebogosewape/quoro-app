# API Environment Example
NODE_ENV=development
PORT=2200
CORS_ORIGIN=http://localhost:2100
WEB_APP_URL=http://localhost:2100

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_NAME=quora_app
DB_DATABASE=

# Security
JWT_SECRET=replace-with-strong-jwt-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace-with-session-secret
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
TRACE_HEADER_NAME=X-Trace-Id
PASSWORD_RESET_TTL_MINUTES=30

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=mailhog
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Queue / Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=quora-app
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_ATTEMPTS=5
EMAIL_QUEUE_BACKOFF_MS=5000
EMAIL_QUEUE_BACKOFF_STRATEGY=exponential
EMAIL_QUEUE_REMOVE_ON_COMPLETE=true
EMAIL_QUEUE_REMOVE_ON_FAIL=false

# SMS
SMS_PROVIDER=mock
SMS_BASE_URL=
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=

# Experian
EXPERIAN_ENV=mock
EXPERIAN_BASE_URL=http://experian-mock:8080
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=

# WhatsApp
WHATSAPP_DEV_MODE=true
WHATSAPP_DEV_NUMBER=0833532301

QUEUE_DASHBOARD_ENABLED=false
QUEUE_DASHBOARD_PATH=/queues
QUEUE_DASHBOARD_USERNAME=
QUEUE_DASHBOARD_PASSWORD=
