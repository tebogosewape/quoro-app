{
    "name": "quora-financial-app",
    "version": "1.0.0",
    "description": "Quora Financial Solutions - Full Stack Platform",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
        "dev:api": "npm run start:dev --workspace=apps/api",
        "dev:web": "npm run dev --workspace=apps/web",
        "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
        "build:api": "npm run build --workspace=apps/api",
        "build:web": "npm run build --workspace=apps/web",
        "test": "npm run test --workspaces",
        "test:api": "npm run test --workspace=apps/api",
        "test:web": "npm run test --workspace=apps/web",
        "lint": "npm run lint --workspaces",
        "format": "prettier --write .",
        "typecheck": "npm run typecheck --workspaces",
        "db:migrate": "npm run migration:run --workspace=apps/api",
        "db:revert": "npm run migration:revert --workspace=apps/api",
        "db:seed": "npm run seed:run --workspace=apps/api",
        "db:reset": "npm run db:reset --workspace=apps/api",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f"
    },
    "devDependencies": {
        "@types/node": "^22.15.14",
        "concurrently": "^8.2.2",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.7",
        "prettier": "^3.5.3",
        "typescript": "~5.8.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nestjs/bull": "^0.6.3",
        "@nestjs/common": "^7.6.18",
        "@nestjs/config": "^2.3.4",
        "@nestjs/core": "^7.6.18",
        "@nestjs/event-emitter": "^1.4.2",
        "@nestjs/jwt": "^8.0.1",
        "@nestjs/passport": "^8.2.2",
        "@nestjs/platform-express": "^7.6.18",
        "@nestjs/schedule": "^2.2.3",
        "@nestjs/swagger": "^6.3.0",
        "@nestjs/testing": "^7.6.18",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/typeorm": "^7.1.5",
        "@types/bcrypt": "^6.0.0",
        "@types/nodemailer": "^7.0.2",
        "@types/passport-jwt": "^4.0.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "nodemailer": "^7.0.9",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "qrcode.react": "^4.2.0"
    }
}
