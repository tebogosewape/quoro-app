{
    "__inputs": [],
    "__requires": [
        { "type": "panel", "id": "logs", "name": "Logs", "version": "1.0.0" },
        { "type": "panel", "id": "timeseries", "name": "Time series", "version": "9.0.0" },
        { "type": "panel", "id": "stat", "name": "Stat", "version": "9.0.0" },
        { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
    ],
    "editable": true,
    "graphTooltip": 0,
    "panels": [
        {
            "datasource": { "type": "loki", "uid": "loki" },
            "fieldConfig": { "defaults": {}, "overrides": [] },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
            "id": 1,
            "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": true,
                "showLabels": true,
                "showTime": true,
                "sortOrder": "Descending"
            },
            "targets": [
                {
                    "expr": "{project=\"quora-web-app\"}",
                    "refId": "A"
                }
            ],
            "title": "Recent Logs",
            "type": "logs"
        },
        {
            "datasource": { "type": "loki", "uid": "loki" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
            "id": 2,
            "options": {
                "legend": { "calcs": [], "displayMode": "table", "placement": "right" },
                "tooltip": { "mode": "multi" }
            },
            "targets": [
                {
                    "expr": "sum by (service)(count_over_time({project=\"quora-web-app\"}[5m]))",
                    "legendFormat": "{{service}}",
                    "refId": "A"
                }
            ],
            "title": "Log Volume by Service",
            "type": "timeseries"
        },
        {
            "datasource": { "type": "loki", "uid": "loki" },
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "noValue": "0"
                },
                "overrides": []
            },
            "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
            "id": 3,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": ["last"],
                    "fields": "",
                    "values": false
                }
            },
            "targets": [
                {
                    "expr": "sum(count_over_time(({project=\"quora-web-app\"} |= \"ERROR\")[5m]))",
                    "refId": "A"
                }
            ],
            "title": "Errors (last 5m)",
            "type": "stat"
        },
        {
            "datasource": { "type": "loki", "uid": "loki" },
            "fieldConfig": { "defaults": {}, "overrides": [] },
            "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
            "id": 4,
            "options": {
                "showHeader": true
            },
            "targets": [
                {
                    "expr": "topk(10, sum by (container)(count_over_time({project=\"quora-web-app\"}[10m])))",
                    "refId": "A"
                }
            ],
            "title": "Top Talkers",
            "transformations": [
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true
                        },
                        "indexByName": {
                            "Value": 1,
                            "container": 0
                        },
                        "renameByName": {
                            "Value": "Log Count"
                        }
                    }
                }
            ],
            "type": "table"
        }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": ["loki", "logs", "quora"],
    "templating": {
        "list": [
            {
                "datasource": { "type": "loki", "uid": "loki" },
                "definition": "label_values({project=\"quora-web-app\"}, service)",
                "hide": 0,
                "includeAll": true,
                "label": "Service",
                "multi": true,
                "name": "service",
                "options": [],
                "query": "label_values({project=\"quora-web-app\"}, service)",
                "refresh": 2,
                "regex": "",
                "skipUrlSync": false,
                "type": "query"
            }
        ]
    },
    "time": { "from": "now-1h", "to": "now" },
    "timezone": "",
    "title": "Quora App Logs",
    "uid": "quora-app-logs",
    "version": 1
}
