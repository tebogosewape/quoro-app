# Production Environment Variables
# SECURITY WARNING: Never commit this file to version control
# Set these values in your production environment

# API Configuration
NODE_ENV=production
PORT=2200
CORS_ORIGIN=https://your-domain.com

# Database Configuration (MySQL for production)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=quora_app
DB_USERNAME=your_db_username
DB_PASSWORD=your_strong_db_password
DB_ROOT_PASSWORD=your_strong_root_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# SMS Configuration
SMS_PROVIDER=zoomconnect
SMS_BASE_URL=https://api.zoomconnect.com
SMS_API_KEY=your-zoomconnect-api-key
SMS_USERNAME=your-zoomconnect-username
SMS_PASSWORD=your-zoomconnect-password

# Experian Configuration
EXPERIAN_ENV=production
EXPERIAN_BASE_URL=https://api.experian.co.za
EXPERIAN_USERNAME=your-experian-username
EXPERIAN_PASSWORD=your-experian-password

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-minimum-32-characters-long

# Frontend URL for CORS and redirects
VITE_APP_NAME=Quora Financial Web
VITE_API_URL=https://api.your-domain.com/api
VITE_API_TIMEOUT=10000
VITE_TRACE_HEADER=X-Trace-Id
