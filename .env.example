# Development Environment Variables
# Copy this to .env.development and customize values

# API Configuration
NODE_ENV=development
PORT=2200
CORS_ORIGIN=http://localhost:2100

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_NAME=quora_app

# JWT Configuration
JWT_SECRET=dev-secret-change-in-production-very-long-random-string
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-very-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (MailHog for development)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# SMS Configuration (Mock for development)
SMS_PROVIDER=mock
SMS_BASE_URL=
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=

# Experian Configuration (Mock for development)
EXPERIAN_ENV=mock
EXPERIAN_BASE_URL=http://localhost:8080
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=combined

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=dev-session-secret-change-in-production

# Frontend (Vite)
VITE_APP_NAME=Quora Financial Web
VITE_API_URL=http://localhost:2200/api
VITE_API_TIMEOUT=10000
VITE_TRACE_HEADER=X-Trace-Id
